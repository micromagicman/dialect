// Первый пример агента на Dialect (v0.1).
agent Support {
    model = "gpt-4o"
    system = "Ты — дружелюбный помощник. Отвечай кратко и по делу."
    temperature = 0.3

    tool web_search
    tool file_read

    memory persistent = true
}

// Среда (харнесс), в которой живёт агент.
harness Support {
    gateway telegram
    allow user 196778804
    cron "daily-digest" every "0 9 * * *" run digest
}
